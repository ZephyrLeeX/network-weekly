# Example secrets file for the Network Weekly Report System.
# Copy to /etc/network-report/secrets.env and fill in real values.
# The real file MUST have permission 0600 (SYSTEM_SPEC.md §22.2) and must
# never be committed to Git, baked into images or logged.
#
# Keys are per credential profile: <KIND>_<PROFILE> with "-" in the profile
# name mapped to "_". Multiple devices may reference one profile; devices with
# different credentials use different profiles. The profile name is only a
# reference from devices.toml; community strings and passwords stay here.

SNMP_COMMUNITY_DEFAULT=change-me-snmp-community
SSH_USERNAME_DEFAULT=netreport
SSH_PASSWORD_DEFAULT=change-me-ssh-password

# credential_profile = "core-a" -> suffix CORE_A
SNMP_COMMUNITY_CORE_A=change-me-core-a-snmp-community
SSH_USERNAME_CORE_A=netreport
SSH_PASSWORD_CORE_A=change-me-core-a-ssh-password

# credential_profile = "core-b" -> suffix CORE_B
SNMP_COMMUNITY_CORE_B=change-me-core-b-snmp-community
SSH_USERNAME_CORE_B=netreport
SSH_PASSWORD_CORE_B=change-me-core-b-ssh-password
