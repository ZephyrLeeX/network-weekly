# Copy to .env and adjust. docker compose loads .env automatically.
# The values below are LOCAL DEVELOPMENT placeholders, not production secrets.
# Production installs use real values created by install.sh (Wave 5,
# SYSTEM_SPEC.md §26.1: /etc/network-report, 0600 secrets file).

POSTGRES_USER=network_report
POSTGRES_PASSWORD=network_report
POSTGRES_DB=network_report

# Persistent PostgreSQL data and generated reports (bind mounts)
NETWORK_REPORT_DATA_DIR=./data

# Host-side integration tests (`uv run pytest -m integration`) target this DB.
NETWORK_REPORT_TEST_DATABASE_URL=postgresql+psycopg://network_report:network_report@127.0.0.1:15432/network_report_test
